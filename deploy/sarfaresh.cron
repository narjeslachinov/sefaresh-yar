# Demo data is rebuilt daily so the "live" tables never look days old. Backups nightly.
0 6 * * * root node --env-file=/etc/sarfaresh/admin.env /opt/sarfaresh/scripts/seed-demo.mjs >> /var/log/sarfaresh-seed.log 2>&1
30 2 * * * root /opt/sarfaresh/deploy/backup.sh >> /var/log/sarfaresh-backup.log 2>&1